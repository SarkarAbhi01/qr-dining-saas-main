# --- Server ---
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# --- Database (PostgreSQL) ---
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/qr_dining_saas?schema=public"

# --- JWT ---
JWT_ACCESS_SECRET=replace_with_a_long_random_string
JWT_REFRESH_SECRET=replace_with_a_different_long_random_string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# --- Bootstrap Superadmin (used by prisma/seed.js) ---
SUPERADMIN_EMAIL=superadmin@platform.com
SUPERADMIN_PASSWORD=ChangeMe123!

# --- Payments ---
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxx
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxx

# --- QR Code Generation ---
# (Intentionally no QR_BASE_URL here — the QR is rendered client-side using
# whatever origin the Owner's browser is currently on, so it's correct in
# both local dev and production automatically. See frontend Tables.jsx.)
